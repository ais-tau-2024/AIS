    def get_all_specialities(cls, fields=None, paginate=False, page=1, per_page=15):
        """
        ## Возвращает список всех специальностей с опциональной пагинацией и выборкой полей

        ### Необходимые аргументы:
        - fields - список полей для выборки, по умолчанию все поля
        - paginate - флаг пагинации
        - page - номер страницы
        - per_page - количество элементов на странице

        Если указан флаг пагинации - возвращает список специальностей с пагинацией. Иначе возвращает список всех специальностей
        """
        specialities = cls.objects.all()
        if fields:
            specialities = specialities.values(*fields)
        if paginate:
            specialities = specialities.order_by('-id')  # Сортировка по убыванию ID
            paginator = Paginator(specialities, per_page)
            paginated_specialities = paginator.get_page(page)
            return {
                "specialities": list(paginated_specialities.object_list),
                "total_pages": paginator.num_pages,
                "current_page": paginated_specialities.number,
                "has_next": paginated_specialities.has_next(),
                "has_previous": paginated_specialities.has_previous()
            }
        else:
            if fields:
                return list(specialities)
            else:
                return list(specialities.values('id', 'title', 'short_title', 'code'))

    @classmethod
    def delete_speciality(cls, speciality_id):
        """
        ## Удаляет специальность по ID

        ### Необходимые аргументы:
        - speciality_id - ID специальности

        Возвращает True, если специальность удалена
