    @classmethod
    def get_speciality(cls, speciality_id):
        """
        ## Возвращает специальность по ID

        ### Необходимые аргументы:
        - speciality_id - ID специальности

        Возвращает специальность
        """
        return cls.objects.filter(id=speciality_id).first() or None

