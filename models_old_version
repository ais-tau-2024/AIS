    """
    teacher = models.ForeignKey('TeacherModel', on_delete=models.CASCADE, related_name='audiences')
    audience = models.ForeignKey('AudienceModel', on_delete=models.CASCADE, related_name='teachers')

    @classmethod
    def add_audience(cls, teacher, audience):
        """
        Добавляет аудиторию к преподавателю.

