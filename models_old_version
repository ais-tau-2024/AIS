    Модель преподавателя
    - iin - ИИН преподавателя, макс длина 8
    - first_name - имя, макс длина 50
    - last_name - фамилия, макс длина 50
    - patronymic - отчество, макс длина 50, может быть пустым

    ### Методы:
    - create_teacher - создает нового преподавателя и возвращает его
    - get_teacher - возвращает преподавателя по ID
    - get_all_teachers - возвращает список всех преподавателей
    - delete_teacher - удаляет преподавателя по ID
    - authenticate - аутентифицирует преподавателя по ИИН и паролю
    - logout - выходит из системы, удаляя токен
    - change_name - сменяет имя, фамилию и отчество преподавателя
    """
    iin = models.CharField(
        max_length=8,
        unique=True,  # Enforce uniqueness
        validators=[
            MinLengthValidator(8),
            RegexValidator(
                regex='^\d{8}$',
                message='IIN must be exactly 8 digits.',
                code='invalid_iin'
            )
        ]
    )
    first_name = models.CharField(max_length=50)
    last_name = models.CharField(max_length=50)
    patronymic = models.CharField(max_length=50, null=True, blank=True)

    @classmethod
    def create_teacher(cls, iin, first_name, last_name, patronymic=None, password=None):
        """
        Создает нового преподавателя вместе с его аутентификационными данными.

        ### Необходимые аргументы:
        - iin - ИИН преподавателя, макс длина 8
        - first_name - имя, макс длина 50
        - last_name - фамилия, макс длина 50
        - patronymic - отчество, макс длина 50, может быть пустым
        - password - пароль преподавателя

        Возвращает созданного преподавателя
        """
        teacher = cls.objects.create(
            iin=iin,
            first_name=first_name,
            last_name=last_name,
            patronymic=patronymic
        )
        if password:
            TeacherAuthModel.create_auth(teacher, password)
        return teacher

    @classmethod
    def get_teacher(cls, teacher_id):
        """
        Возвращает преподавателя по ID.

        ### Необходимые аргументы:
        - teacher_id - ID преподавателя

        Возвращает преподавателя
        """
        return cls.objects.filter(id=teacher_id).first()

    @classmethod
    def get_all_teachers(cls, fields=None, paginate=False, page=1, per_page=15):
        """
        Возвращает список преподавателей с пагинацией и выборкой полей.
        Первая страница содержит последних добавленных преподавателей.

        ### Необходимые аргументы:
        - fields - список полей для выборки, по умолчанию все поля
        - paginate - флаг пагинации
        - page - номер страницы
        - per_page - количество элементов на странице

        Возвращает словарь с преподавателями и информацией о пагинации
        """
        teachers = cls.objects.all()
        if fields:
            teachers = teachers.values(*fields)
        if paginate:
            teachers = teachers.order_by('-id')  # Сортировка по убыванию ID
            paginator = Paginator(teachers, per_page)
            paginated_teachers = paginator.get_page(page)
            return {
                "teachers": list(paginated_teachers.object_list),
                "total_pages": paginator.num_pages,
                "current_page": paginated_teachers.number,
                "has_next": paginated_teachers.has_next(),
                "has_previous": paginated_teachers.has_previous()
            }
        else:
            if fields:
                return list(teachers)
            else:
                return list(teachers.values('id', 'iin', 'first_name', 'last_name', 'patronymic'))

    @classmethod
    def delete_teacher(cls, teacher_id):
        """
        Удаляет преподавателя по ID.

        ### Необходимые аргументы:
        - teacher_id - ID преподавателя

        Возвращает True, если преподаватель удален
        """
        teacher = cls.objects.filter(id=teacher_id).first()
        if teacher:
            teacher.delete()
            return True
        return False

    @classmethod
    def authenticate(cls, iin, password):
        """
        Аутентифицирует преподавателя по ИИН и паролю.

        ### Необходимые аргументы:
        - iin - ИИН преподавателя
        - password - пароль

        Возвращает токен аутентификации, если успешна, иначе None
        """
        teacher = cls.objects.filter(iin=iin).first()
        if teacher and TeacherAuthModel.verify_password(teacher, password):
            # Create a new auth token
            token = TeacherAuthTokenModel.create_token(teacher)
            return token.token
        return None

    @classmethod
    def logout(cls, token_str):
        """
        Выход из системы. Удаляет запись в таблице TeacherAuthTokenModel.

        ### Необходимые аргументы:
        - token_str - строка токена

        Возвращает True, если токен удален, иначе False
        """
        token = TeacherAuthTokenModel.objects.filter(token=token_str).first()
        if token:
            token.delete()
            return True
        return False

    def change_name(self, first_name, last_name, patronymic=None):
        """
        Сменяет имя, фамилию и отчество преподавателя.

        ### Необходимые аргументы:
        - first_name - имя, макс длина 50
        - last_name - фамилия, макс длина 50
        - patronymic - отчество, макс длина 50, может быть пустым
        """
        self.first_name = first_name
        self.last_name = last_name
        self.patronymic = patronymic
        self.save()


class TeacherAuthModel(models.Model):
    """
    Модель авторизации преподавателя
    - teacher - преподаватель (ссылка на модель)
    - password - пароль (хэшированный)

    ### Методы:
    - create_auth - создает запись авторизации с хэшированным паролем
    - verify_password - проверяет соответствие пароля
    """
    teacher = models.OneToOneField('TeacherModel', on_delete=models.CASCADE, related_name='auth')
    password = models.CharField(max_length=255)

    @classmethod
    def create_auth(cls, teacher, raw_password):
        """
        Создает запись авторизации с хэшированным паролем.

        ### Необходимые аргументы:
        - teacher - экземпляр TeacherModel
        - raw_password - пароль в открытом виде

        Возвращает созданную запись авторизации
        """
        hashed_password = make_password(raw_password)
        return cls.objects.create(teacher=teacher, password=hashed_password)

    @classmethod
    def verify_password(cls, teacher, raw_password):
        """
        Проверяет соответствие пароля.

        ### Необходимые аргументы:
        - teacher - экземпляр TeacherModel
        - raw_password - пароль в открытом виде

        Возвращает True, если пароль верен, иначе False
        """
        try:
            auth = cls.objects.get(teacher=teacher)
            return check_password(raw_password, auth.password)
        except cls.DoesNotExist:
            return False


class TeacherAuthTokenModel(models.Model):
    """
    Модель токенов преподавателя
    - teacher - преподаватель (ссылка на модель, TeacherAuthToken запись будет удалена при удалении Teacher)
    - token - токен, всегда уникален

    ### Методы:
